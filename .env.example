NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/baracee
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=30d
CLIENT_ORIGIN=http://localhost:5500

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bara Cee

# Set a long random secret. Use this only from a trusted admin machine.
ADMIN_VERIFY_KEY=

# Optional Cloudinary storage. Recommended for Render production uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Listing lifecycle: visible 30 hours, permanently removed 3 days later.
LISTING_VISIBLE_HOURS=30
LISTING_RETENTION_DAYS=3

# PayHero is deliberately disabled until your actual PayHero credentials,
# callback URL and current API request format have been configured and tested.
PAYHERO_CHANNEL_ID=
PAYHERO_BASIC_AUTH=
PAYHERO_CALLBACK_URL=
